{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StagingStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:UpdateStack",
        "cloudformation:CreateStack"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:934685482023:stack/learnspace-discovery-agent-staging/*",
        "arn:aws:cloudformation:us-east-1:934685482023:changeSet/awscli-cloudformation-package-deploy-*/*",
        "arn:aws:cloudformation:us-east-1:934685482023:stack/learnspace-worker-staging/*"
      ]
    },
    {
      "Sid": "ValidateTemplate",
      "Effect": "Allow",
      "Action": "cloudformation:ValidateTemplate",
      "Resource": "*"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "StagingImage",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:GetRepositoryPolicy",
        "ecr:SetRepositoryPolicy",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:934685482023:repository/learnspace-discovery-agent-staging",
        "arn:aws:ecr:us-east-1:934685482023:repository/learnspace-worker-staging"
      ]
    },
    {
      "Sid": "StagingFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags",
        "lambda:GetFunctionConcurrency",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:934685482023:function:learnspace-discovery-agent-staging",
        "arn:aws:lambda:us-east-1:934685482023:function:learnspace-discovery-agent-staging:*"
      ]
    },
    {
      "Sid": "ExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::934685482023:role/learnspace-discovery-agent-staging-execution",
        "arn:aws:iam::934685482023:role/learnspace-worker-staging-execution"
      ]
    },
    {
      "Sid": "ExecutionLoggingPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::934685482023:role/learnspace-discovery-agent-staging-execution",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "PassExecutionRoleToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::934685482023:role/learnspace-discovery-agent-staging-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadDeploymentSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:934685482023:secret:learnspace/staging/discovery/exa-ahwch5",
        "arn:aws:secretsmanager:us-east-1:934685482023:secret:learnspace/staging/discovery/internal-token-4Tn4hA"
      ]
    },
    {
      "Sid": "CreateNamedDiscoveryApi",
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:us-east-1::/apis",
      "Condition": {
        "StringEquals": {
          "apigateway:Request/ApiName": "learnspace-discovery-agent-staging-http"
        }
      }
    },
    {
      "Sid": "StagingDiscoveryApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:POST",
        "apigateway:DELETE",
        "apigateway:PUT"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/n108t7s9vd",
        "arn:aws:apigateway:us-east-1::/apis/n108t7s9vd/*",
        "arn:aws:apigateway:us-east-1::/tags/arn:aws:apigateway:us-east-1::/apis/n108t7s9vd"
      ]
    },
    {
      "Sid": "WorkerRuntimeSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:934685482023:secret:learnspace/staging/worker/runtime-fEGrXW"
    },
    {
      "Sid": "PassWorkerExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::934685482023:role/learnspace-worker-staging-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "WorkerContainers",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DescribeClusters",
        "ecs:DeleteCluster",
        "ecs:CreateService",
        "ecs:DescribeServices",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:DescribeTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:TagResource",
        "ecs:UntagResource",
        "ecs:ListTagsForResource",
        "ecs:ListTasks",
        "ecs:DescribeTasks"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-1:934685482023:cluster/learnspace-worker-staging",
        "arn:aws:ecs:us-east-1:934685482023:service/learnspace-worker-staging/learnspace-worker-staging",
        "arn:aws:ecs:us-east-1:934685482023:task-definition/learnspace-worker-staging:*",
        "arn:aws:ecs:us-east-1:934685482023:task/learnspace-worker-staging/*"
      ]
    },
    {
      "Sid": "RegisterWorkerTask",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/LearnSpaceWorker": "staging"
        }
      }
    },
    {
      "Sid": "WorkerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:934685482023:log-group:/learnspace/worker/staging:*"
    },
    {
      "Sid": "WorkerInfrastructureInventory",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkerNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:934685482023:security-group/*",
        "arn:aws:ec2:us-east-1:934685482023:vpc/vpc-02c4dca1203de4511"
      ],
      "Condition": {
        "ArnEquals": {
          "ec2:Vpc": "arn:aws:ec2:us-east-1:934685482023:vpc/vpc-02c4dca1203de4511"
        }
      }
    },
    {
      "Sid": "WorkerNetworkTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:us-east-1:934685482023:security-group/*"
    }
  ]
}

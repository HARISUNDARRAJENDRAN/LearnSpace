# Local Docker Compose configuration. Copy to .env when you need to override
# the safe defaults below: cp .env.example .env

# Required by the web session cookie and the internal worker-to-agent call.
AUTH_SECRET=local-development-auth-secret-change-me-please
INTERNAL_SERVICE_TOKEN=local-development-internal-token

# Optional external providers. Discovery remains disabled until explicitly
# enabled, so the local stack works without paid API credentials.
DISCOVERY_AGENTS_ENABLED=false
EXA_API_KEY=
OPENAI_API_KEY=
DISCOVERY_YOUTUBE_ENRICHMENT_ENABLED=false
DISCOVERY_YOUTUBE_EMBEDDER_PROVIDER=openai
DISCOVERY_YOUTUBE_EMBEDDER_MODEL=text-embedding-3-small
DISCOVERY_MAX_CONCURRENCY=2
DISCOVERY_MAX_TOOL_CALLS=4
DISCOVERY_REQUEST_TIMEOUT_SECONDS=8

# Local auth defaults. Verification and reset links are returned by the UI.
AUTH_RATE_LIMIT_BACKEND=memory
AUTH_EXPOSE_VERIFICATION_LINK=true
EMAIL_FROM=LearnSpace <noreply@example.com>
RESEND_API_KEY=

# Optional Google OAuth credentials for local testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Host ports and public URL used by the local Compose stack.
APP_URL=http://localhost:3000
WEB_PORT=3000
AI_PORT=8080
POSTGRES_PORT=55432

# Discovery worker scheduling overrides.
DISCOVERY_WORKER_INTERVAL_MS=30000
DISCOVERY_WORKER_MAX_JOBS=0
DISCOVERY_AGENT_TIMEOUT_SECONDS=120
DISCOVERY_REFRESH_FAST_HOURS=12
DISCOVERY_REFRESH_MEDIUM_HOURS=24
DISCOVERY_REFRESH_SLOW_HOURS=72
DISCOVERY_REFRESH_JITTER_PERCENT=0.1
DISCOVERY_REFRESH_DEDUP_HOURS=12

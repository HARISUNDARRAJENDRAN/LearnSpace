# Runtime application connection.
DATABASE_URL=postgres://learnspace_app:learnspace_app@localhost:55432/learnspace

# Runtime authentication connection.
DATABASE_AUTH_URL=postgres://learnspace_auth:learnspace_auth@localhost:55432/learnspace

# Migration/verification connection. Never use this for web traffic.
DATABASE_MIGRATOR_URL=postgres://learnspace_migrator:learnspace_migrator@localhost:55432/learnspace

# One-time local/cloud bootstrap connection. Never expose to Vercel runtime.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:55432/learnspace
DATABASE_APP_URL=postgres://learnspace_app:learnspace_app@localhost:55432/learnspace
DATABASE_AI_URL=postgres://learnspace_ai:learnspace_ai@localhost:55432/learnspace
DATABASE_WORKER_URL=postgres://learnspace_worker:learnspace_worker@localhost:55432/learnspace
DATABASE_RUNNER_URL=postgres://learnspace_runner:learnspace_runner@localhost:55432/learnspace

# Staging runtime overrides: DB_POOL_MAX=1, DB_MAX_LIFETIME_SECONDS=300,
# DB_PREPARED_STATEMENTS=false.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_MAX_LIFETIME_SECONDS=3600
DB_PREPARED_STATEMENTS=true
DB_STATEMENT_TIMEOUT_MS=3000
DB_LOCK_TIMEOUT_MS=500

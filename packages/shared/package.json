{
  "name": "@learnspace/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./domain-values": {
      "types": "./src/domain-values.ts",
      "import": "./dist/domain-values.js",
      "default": "./dist/domain-values.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./onboarding": {
      "types": "./src/onboarding.ts",
      "import": "./dist/onboarding.js",
      "default": "./dist/onboarding.js"
    },
    "./password": {
      "types": "./src/password.ts",
      "import": "./dist/password.js",
      "default": "./dist/password.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/contracts.test.ts src/source-discovery.test.ts"
  },
  "dependencies": {
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}

{
  "name": "learnspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "build": "turbo run build",
    "desktop:dev": "pnpm --filter @learnspace/desktop dev",
    "desktop:smoke": "pnpm --filter @learnspace/desktop build && pnpm --filter @learnspace/desktop smoke",
    "desktop:build": "pnpm --filter @learnspace/web build && pnpm --filter @learnspace/desktop prepare-runtime",
    "desktop:package": "pnpm --filter @learnspace/web build && pnpm --filter @learnspace/desktop package",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @learnspace/db db:generate",
    "db:check": "pnpm --filter @learnspace/db db:check",
    "db:bootstrap:remote": "pnpm --filter @learnspace/db db:bootstrap:remote",
    "db:migrate": "pnpm --filter @learnspace/db db:migrate",
    "db:ledger": "pnpm --filter @learnspace/db db:ledger",
    "db:verify": "pnpm --filter @learnspace/db db:verify",
    "db:test": "pnpm --filter @learnspace/db db:test",
    "db:seed:dev": "pnpm --filter @learnspace/db db:seed:dev",
    "db:reset:local": "pnpm --filter @learnspace/db db:reset:local",
    "db:studio": "pnpm --filter @learnspace/db db:studio",
    "discovery:import:youtube-dataset": "pnpm --filter @learnspace/web run discovery:import:youtube-dataset",
    "discovery:worker": "pnpm --filter @learnspace/worker run discovery:worker",
    "discovery:smoke": "pnpm --filter @learnspace/worker run discovery:smoke"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}

{
  "name": "@learnspace/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "bundle:edge": "node scripts/bundle-edge.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/discovery.test.ts src/discovery-lanes.test.ts src/youtube-metrics.test.ts src/transcripts.test.ts src/discovery.integration.test.ts src/paper-catalog.test.ts src/paper-catalog-materialization.test.ts src/paper-ingestion.test.ts",
    "start": "node dist/index.js",
    "discovery:once": "tsx src/index.ts",
    "discovery:worker": "tsx src/index.ts --loop",
    "discovery:smoke": "tsx src/discovery-smoke.ts",
    "recommendations:backfill": "tsx src/recommendation-backfill.ts",
    "youtube:backfill": "tsx src/youtube-backfill.ts",
    "research:catalog:backfill": "tsx src/paper-catalog-backfill.ts",
    "transcripts:signer": "tsx src/transcript-signer.ts"
  },
  "dependencies": {
    "@learnspace/shared": "workspace:*",
    "@learnspace/pdf-parser": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12"
  },
  "files": [
    "dist"
  ]
}

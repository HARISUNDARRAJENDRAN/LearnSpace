# syntax=docker/dockerfile:1
FROM public.ecr.aws/lambda/python:3.13@sha256:1d975f579a9921b071293f75979f2a232f30889932bbdd59ee53a8dfa849198a

WORKDIR ${LAMBDA_TASK_ROOT}
ENV HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_CACHE_DIR=/root/.cache/uv \
    UV_HTTP_TIMEOUT=180 \
    UV_CONCURRENT_DOWNLOADS=4
COPY pyproject.toml uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --timeout 120 uv==0.11.28 \
    && uv export --frozen --no-dev --no-emit-project --format requirements-txt --output-file /tmp/requirements.txt >/dev/null \
    && uv pip install --system -r /tmp/requirements.txt

COPY app ./app
COPY lambda_handler.py ./lambda_handler.py

CMD ["lambda_handler.handler"]

# Server-only runtime connections. Use pooled provider URLs in staging.
DATABASE_URL=postgres://learnspace_app:learnspace_app@localhost:55432/learnspace
DATABASE_AUTH_URL=postgres://learnspace_auth:learnspace_auth@localhost:55432/learnspace

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-32-byte-secret
APP_URL=http://localhost:3000

# Optional Google OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional Resend delivery. In development, verification links are returned in the UI.
RESEND_API_KEY=
EMAIL_FROM=LearnSpace <noreply@example.com>
AUTH_EXPOSE_VERIFICATION_LINK=true

# Local defaults. Staging uses DB_POOL_MAX=1 and DB_PREPARED_STATEMENTS=false.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_MAX_LIFETIME_SECONDS=3600
DB_PREPARED_STATEMENTS=true
DB_STATEMENT_TIMEOUT_MS=3000
DB_LOCK_TIMEOUT_MS=500

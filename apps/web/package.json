{
  "name": "@learnspace/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev --webpack",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint app components tests next.config.mjs types.d.ts",
    "test": "tsx --tsconfig tsconfig.test.json --test --test-concurrency=1 tests/hero.test.tsx tests/auth.test.ts tests/auth.integration.test.ts tests/onboarding.integration.test.ts tests/discovery.test.ts tests/discovery.integration.test.ts tests/source-discovery.integration.test.ts tests/home.integration.test.ts tests/study.integration.test.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:production": "node tests/e2e/run.mjs --production",
    "benchmark:source-discovery": "node scripts/benchmark-source-discovery.mjs",
    "verify:auth-layout": "node scripts/verify-auth-layout.mjs",
    "discovery:import:youtube-dataset": "tsx scripts/import-youtube-dataset.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@learnspace/db": "workspace:*",
    "@learnspace/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.52.0",
    "@types/node": "26.4.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "postgres": "3.4.9",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}

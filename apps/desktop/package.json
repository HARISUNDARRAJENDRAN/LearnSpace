{
  "name": "@learnspace/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/server-ready.test.ts tests/free-port.test.ts",
    "dev": "pnpm run build && electron dist/main.js",
    "start": "electron dist/main.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "26.4.0",
    "electron": "^40.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}

{
  "name": "@learnspace/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LearnSpace for Linux, Windows, and macOS",
  "homepage": "https://learn-space.app",
  "author": {
    "name": "Harisundar R",
    "email": "hsundar080506@gmail.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "desktopName": "learnspace.desktop",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/links.test.ts",
    "start": "tsc --build && electron .",
    "dist": "tsc --build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "app.learnspace.desktop",
    "productName": "LearnSpace",
    "artifactName": "LearnSpace-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*.js",
      "!dist/**/*.test.js"
    ],
    "protocols": [
      {
        "name": "LearnSpace",
        "schemes": [
          "learnspace"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "executableName": "learnspace"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education"
    }
  }
}

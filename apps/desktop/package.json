{
  "name": "@learnspace/desktop",
  "version": "0.1.0",
  "description": "AI-native learning, research, and knowledge-retention workspace",
  "author": "LearnSpace <noreply@learnspace.ai>",
  "private": true,
  "homepage": "https://github.com/HARISUNDARRAJENDRAN/LearnSpace",
  "type": "module",
  "main": "dist/main.js",
  "desktopName": "LearnSpace.desktop",
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/server-ready.test.ts",
    "dev": "pnpm run build && electron dist/main.js",
    "start": "electron dist/main.js",
    "smoke": "node scripts/smoke.mjs",
    "prepare-release": "node scripts/prepare-release.mjs",
    "package": "pnpm run build && pnpm run prepare-release && electron-builder --linux --config electron-builder.yml"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.52.0",
    "@types/node": "26.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
